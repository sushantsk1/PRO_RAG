# Copy to .env and fill your own NVIDIA API key. Keep .env private.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000
# The supplied Nemotron example enables thinking. Keep it off for short RAG
# answers; set true if you want longer reasoning with a higher token budget.
NVIDIA_ENABLE_THINKING=false

# Local API and data
PORT=8787
DATA_DIR=./data
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./data/models
# Use MODEL_MODE=stub only for local automated testing.
# MODEL_MODE=stub
